<Window x:Class="Presentacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos" Height="480" Width="720">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="Buscar" DockPanel.Dock="Right" Width="70" Margin="6,0,0,0" Click="Buscar_Click"/>
            <TextBox x:Name="txtBuscar" KeyDown="TxtBuscar_KeyDown"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,6,0"><TextBlock Text="Nombre"/><TextBox x:Name="txtNombre"/></StackPanel>
                <StackPanel Margin="0,0,6,0"><TextBlock Text="Cantidad por unidad"/><TextBox x:Name="txtCantidad"/></StackPanel>
                <StackPanel Margin="0,0,6,0"><TextBlock Text="Precio"/><TextBox x:Name="txtPrecio"/></StackPanel>
                <StackPanel><TextBlock Text="Stock"/><TextBox x:Name="txtStock"/></StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Nuevo" Width="80" Margin="0,0,6,0" Click="Nuevo_Click"/>
                <Button Content="Guardar" Width="80" Margin="0,0,6,0" Click="Guardar_Click"/>
                <Button Content="Eliminar" Width="80" Click="Eliminar_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding IdProducto}"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Cantidad por unidad" Binding="{Binding CantidadPorUnidad}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio}"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
